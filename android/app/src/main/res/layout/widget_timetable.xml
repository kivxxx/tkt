<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:padding="12dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日課表"
            android:textStyle="bold"
            android:textColor="#111111"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:text="09/16 (二)"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 移除 debug 欄位，恢復正式版面 -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:background="#1F000000"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp">

        <!-- 課程 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/course1_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="計算機概論"
                    android:textColor="#111111"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/course1_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="第1-2節"
                    android:textColor="#666666"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/course1_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RB-101"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 課程 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/course2_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="線性代數"
                    android:textColor="#111111"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/course2_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="第3-4節"
                    android:textColor="#666666"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/course2_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MA-302"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 課程 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/course3_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="資料結構"
                    android:textColor="#111111"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/course3_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="第6-7節"
                    android:textColor="#666666"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/course3_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CS-204"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 課程 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/course4_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="作業系統"
                    android:textColor="#111111"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/course4_session"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="第8-9節"
                    android:textColor="#666666"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/course4_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CS-305"
                android:textColor="#888888"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

